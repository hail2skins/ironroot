flowchart LR
    %% Iron Root concept architecture for IRON-2

    Customer["Customer Admin"]

    subgraph Hub["Iron Root Hub (Company-Operated SaaS)"]
        direction TB
        HubPortal["Ops Hub<br/>Internal licensing and fleet console"]
        Entitlements["Licensing and Entitlements"]
        Catalog["Module and Workflow Catalog"]
        Release["Release and Update Metadata"]
        Fleet["Fleet Telemetry and Usage"]
        Federation["Federation Gateway<br/>Appliance registration and sync"]
        Workers["Event and Background Workers"]
    end

    subgraph Estate["Customer Environment"]
        direction TB

        subgraph Appliance["Private Iron Root Appliance (Customer-Controlled)"]
            direction TB
            Portal["Customer Portal"]
            API["API and PowerShell Surface"]
            Control["Controllers<br/>Job coordination and policy execution"]
            Runtime["Engines<br/>Container and function execution"]
            Workflows["Workflow Engine<br/>Conditionals, approvals, retries"]
            Secrets["Secrets and Credentials"]
            State["Audit, Inventory, and Local State"]
            Adapters["Execution Adapters"]
        end

        subgraph Managed["Managed Estate"]
            direction TB
            Windows["Windows Hosts<br/>PSRP and WinRM"]
            Linux["Linux Hosts<br/>SSH"]
            Images["Image Lifecycle"]
            Packages["Patch and Package Services"]
            Hypervisor["Hyper-V and Other Hypervisors"]
            Containers["Containers and Runtime Workloads"]
        end
    end

    Customer --> Portal

    HubPortal --> Entitlements
    HubPortal --> Catalog
    HubPortal --> Fleet
    Release --> Catalog
    Workers --> Fleet
    Workers --> Entitlements

    Federation <-->|"outbound federation over TLS"| API
    Entitlements <-->|"license and feature sync"| API
    Catalog <-->|"module and workflow sync"| API
    Release <-->|"release metadata and packages"| API
    Fleet <-. "health, usage, and inventory" .-> API

    Portal --> API
    API --> Control
    API --> Workflows
    Control --> Runtime
    Control --> Secrets
    Control --> State
    Workflows --> Runtime
    Workflows --> State
    Runtime --> Adapters

    Adapters --> Windows
    Adapters --> Linux
    Adapters --> Images
    Adapters --> Packages
    Adapters --> Hypervisor
    Adapters --> Containers

    classDef user fill:#f4f1de,stroke:#9c6644,color:#1f2937,stroke-width:1.5px;
    classDef hub fill:#dbeafe,stroke:#2563eb,color:#0f172a,stroke-width:1.5px;
    classDef appliance fill:#dcfce7,stroke:#16a34a,color:#0f172a,stroke-width:1.5px;
    classDef managed fill:#fef3c7,stroke:#d97706,color:#0f172a,stroke-width:1.5px;

    class Customer user;
    class HubPortal,Entitlements,Catalog,Release,Fleet,Federation,Workers hub;
    class Portal,API,Control,Runtime,Workflows,Secrets,State,Adapters appliance;
    class Windows,Linux,Images,Packages,Hypervisor,Containers managed;
