flowchart TB
    %% Iron Root hybrid architecture - v1

    User["Customer Admin / Operator"]

    subgraph Cloud["Iron Root Cloud (SaaS Control Plane)"]
        CloudPortal["Cloud Portal\nMulti-tenant web UI"]
        Identity["Identity / Tenant / Subscription Service"]
        Catalog["Module & Workflow Catalog"]
        Release["Release / Update Service"]
        Telemetry["Telemetry / Reporting / Fleet Status"]
        Federation["Federation / Appliance Registration API"]
        Events["Serverless / Event Workers\nwebhooks, notifications, usage jobs"]
    end

    subgraph Customer["Customer Environment"]
        subgraph Appliance["Iron Root Appliance (Customer-Controlled On-Prem)"]
            LocalPortal["Local Portal\n443 Web UI"]
            LocalAPI["Local API"]
            Controller["Controller Service"]
            Workflow["Workflow Engine\nbranching, approvals, retries"]
            Secrets["Secrets / Credential Store"]
            Audit["Audit Log / Local State"]
            AdapterLayer["Execution & Infrastructure Abstraction Layer"]
        end

        subgraph Targets["Managed Targets"]
            Windows["Windows Nodes\nWinRM / PSRP"]
            Linux["Linux Nodes\nSSH"]
            HyperV["Hyper-V Adapter"]
            ContainerRuntime["Container / Workload Adapter"]
            FutureAdapters["Future Adapters\nVMware / Proxmox / Cloud / etc."]
        end
    end

    User --> CloudPortal
    User --> LocalPortal

    CloudPortal --> Identity
    CloudPortal --> Telemetry
    CloudPortal --> Catalog
    CloudPortal --> Federation
    Release --> Catalog
    Events --> Telemetry
    Events --> Identity

    CloudPortal -. "launch / federate" .-> LocalPortal
    Federation <-->|"outbound-only TLS 443"| LocalAPI
    Catalog <-->|"catalog sync"| LocalAPI
    Release <-->|"update metadata / packages"| LocalAPI
    Telemetry <-. "health / usage / inventory metadata" .-> LocalAPI

    LocalPortal --> LocalAPI
    LocalAPI --> Controller
    LocalAPI --> Workflow
    Controller --> Workflow
    Controller --> Secrets
    Controller --> Audit
    Workflow --> Audit
    Workflow --> AdapterLayer

    AdapterLayer --> Windows
    AdapterLayer --> Linux
    AdapterLayer --> HyperV
    AdapterLayer --> ContainerRuntime
    AdapterLayer -.-> FutureAdapters

    classDef cloud fill:#dbeafe,stroke:#1d4ed8,color:#0f172a;
    classDef appliance fill:#dcfce7,stroke:#15803d,color:#0f172a;
    classDef target fill:#fef3c7,stroke:#b45309,color:#0f172a;
    classDef user fill:#f5d0fe,stroke:#a21caf,color:#0f172a;

    class CloudPortal,Identity,Catalog,Release,Telemetry,Federation,Events cloud;
    class LocalPortal,LocalAPI,Controller,Workflow,Secrets,Audit,AdapterLayer appliance;
    class Windows,Linux,HyperV,ContainerRuntime,FutureAdapters target;
    class User user;
